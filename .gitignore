# Build outputs
/bin/
/dist/
/tmp/

# pnpm local store (created by pnpm install when no store config exists)
/.pnpm-store/

# npm lockfile — this repo uses pnpm-lock.yaml; package-lock.json is incidental
testing/e2e/package-lock.json
# Ignore SPA build outputs, but keep the directory itself tracked via
# web/dist/.gitkeep so `//go:embed all:web/dist` always finds at least
# one file on a fresh checkout (before `pnpm build` has been run).
web/dist/*
!web/dist/.gitkeep
web/node_modules/
testing/acceptance/temperature-spa/demo-artifacts/

# Go
*.test
*.out
/vendor/
# `go build ./cmd/<name>/...` drops the binary at repo root; ignore the
# common ones rather than fight `go build`'s defaults.
/gemba
/gemba-ask
/gemba-bridge
/gemba-mcp
/gemba-state
/gemba-bd-hook
/gen-core-types

# Frontend
web/.vite/
.vite/
node_modules/
testing/e2e/test-results/
testing/e2e/playwright-report/
testing/e2e/playwright/.cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Secrets (never commit)
.env
.env.local
*.pem
*.key
*.crt

# Audit log produced at runtime
~/.gemba/

# Gas Town (added by gt)
.runtime/
.claude/
.logs/
__pycache__/
state.json
CLAUDE.local.md

# Rig-level beads config (machine-specific; storage is in Dolt server)
.beads/
.beads/
mail/
.DS_Store
.gitnexus
