{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemba HTTP API",
    "version": "0.1.0",
    "description": "Wire schema for the gemba server's `/api/*` surface (gm-e4.2). The SPA at `web/` consumes a typed client generated from this document; the source of truth lives in `docs/api/openapi.json` and is served at runtime under `/api/openapi.json`.\n\nThis MVP covers the read endpoints the SPA depends on day-to-day: health, version, config, repositories, work items, sprints, agents, sessions, escalations, capabilities, and the new-project conversational flow. The remaining `/api/*` surface (consults, walks, planner, perspectives) is acknowledged in `paths` with summary-only stubs and will gain full request/response schemas in follow-up beads.",
    "contact": {
      "name": "MikeBengtson/gemba",
      "url": "https://github.com/MikeBengtson/gemba"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin (the gemba server is the SPA host)."
    }
  ],
  "tags": [
    { "name": "system", "description": "Liveness, version, runtime configuration." },
    { "name": "work", "description": "WorkItems, sprints, repositories." },
    { "name": "agents", "description": "Agents, agent groups, sessions." },
    { "name": "ops", "description": "Escalations, capabilities, adaptors." },
    { "name": "newproject", "description": "Conversational project-creation flow (gm-root.17)." },
    { "name": "stub", "description": "Routes documented at the URL level only; full request/response schemas land in follow-up beads." }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["system"],
        "summary": "Liveness probe.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Server is up.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "tags": ["system"],
        "summary": "Build / component metadata.",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "Component metadata.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VersionResponse" }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": ["system"],
        "summary": "Runtime configuration snapshot. Includes the beads source identity (gm-77u) the Topbar renders.",
        "operationId": "getConfig",
        "responses": {
          "200": {
            "description": "Runtime configuration.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConfigResponse" }
              }
            }
          }
        }
      }
    },
    "/api/repositories": {
      "get": {
        "tags": ["work"],
        "summary": "List repositories declared in the workspace's RepositoryRegistry.",
        "operationId": "listRepositories",
        "responses": {
          "200": {
            "description": "Repository list. The list may be empty with a `notice` field when the registry directory is missing or malformed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListRepositoriesEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/work-items": {
      "get": {
        "tags": ["work"],
        "summary": "List work items via the bound WorkPlane adaptor.",
        "operationId": "listWorkItems",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "description": "Filter by WorkItem kind (e.g. `epic`, `task`).",
            "schema": { "type": "string" }
          },
          {
            "name": "state_category",
            "in": "query",
            "description": "Filter by normalized state category.",
            "schema": { "$ref": "#/components/schemas/StateCategory" }
          },
          {
            "name": "label",
            "in": "query",
            "description": "Filter by label (repeatable).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "WorkItem list envelope.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListWorkItemsEnvelope" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/work-items/{id}": {
      "get": {
        "tags": ["work"],
        "summary": "Fetch one WorkItem by id.",
        "operationId": "getWorkItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Workspace-prefixed bead id (e.g. `gemba/gm-e4.2`).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The work item.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkItem" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/sprints": {
      "get": {
        "tags": ["work"],
        "summary": "List active sprints (when the WorkPlane reports sprint_native=true).",
        "operationId": "listSprints",
        "responses": {
          "200": {
            "description": "Sprint list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListSprintsEnvelope" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/agents": {
      "get": {
        "tags": ["agents"],
        "summary": "List registered agents.",
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "Agent list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListAgentsEnvelope" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/agent-groups": {
      "get": {
        "tags": ["agents"],
        "summary": "List agent groups.",
        "operationId": "listAgentGroups",
        "responses": {
          "200": {
            "description": "Agent-group list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListAgentGroupsEnvelope" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": ["agents"],
        "summary": "List sessions known to the bound OrchestrationPlane.",
        "operationId": "listSessions",
        "responses": {
          "200": {
            "description": "Session list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionListEnvelope" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/escalations": {
      "get": {
        "tags": ["ops"],
        "summary": "List open escalations.",
        "operationId": "listEscalations",
        "responses": {
          "200": {
            "description": "Escalation list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EscalationListEnvelope" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "tags": ["ops"],
        "summary": "Capability manifests for every bound adaptor.",
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Per-plane capability manifest list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CapabilitiesResponse" }
              }
            }
          }
        }
      }
    },
    "/api/adaptors": {
      "get": {
        "tags": ["ops"],
        "summary": "Snapshot of adaptor health status.",
        "operationId": "getAdaptorsHealth",
        "responses": {
          "200": {
            "description": "Adaptor health snapshot.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdaptorsHealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["system"],
        "summary": "Self-describing schema (this document).",
        "operationId": "getOpenAPISpec",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 spec.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/consults": {
      "get": {
        "tags": ["stub"],
        "summary": "TODO follow-up: persona consult activity list (gm-twp2).",
        "operationId": "listConsults",
        "responses": {
          "200": { "description": "Consult list (schema in follow-up bead)." }
        }
      }
    },
    "/api/skills": {
      "get": {
        "tags": ["stub"],
        "summary": "TODO follow-up: registered persona skills (gm-twp2).",
        "operationId": "listSkills",
        "responses": {
          "200": { "description": "Skill list (schema in follow-up bead)." }
        }
      }
    },
    "/api/v1/walks:start": {
      "post": {
        "tags": ["stub"],
        "summary": "TODO follow-up: start a Gemba walk (gm-wgv).",
        "operationId": "startWalk",
        "responses": {
          "201": { "description": "Walk created (schema in follow-up bead)." }
        }
      }
    },
    "/api/v1/walks:recent": {
      "get": {
        "tags": ["stub"],
        "summary": "TODO follow-up: recent walks list (gm-wgv).",
        "operationId": "listRecentWalks",
        "responses": {
          "200": { "description": "Walk list (schema in follow-up bead)." }
        }
      }
    },
    "/api/planner/coach": {
      "get": {
        "tags": ["stub"],
        "summary": "TODO follow-up: planner-coach recommendation (gm-v5z2).",
        "operationId": "getPlannerCoach",
        "responses": {
          "200": { "description": "Coach response (schema in follow-up bead)." }
        }
      }
    },
    "/api/v1/newproject/start": {
      "post": {
        "tags": ["newproject"],
        "summary": "Open a new-project conversation session. Spawns an Onboarder persona and returns a session id.",
        "operationId": "startNewProject",
        "responses": {
          "201": {
            "description": "Session created. Returns the session id, empty initial state, and an optional greeting from the Onboarder.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StartNewProjectResponse" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/v1/newproject/{id}/turn": {
      "post": {
        "tags": ["newproject"],
        "summary": "Submit an operator message. Returns the updated plan-tree state and the Onboarder skill reply.",
        "operationId": "submitNewProjectTurn",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Session id returned by `startNewProject`.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TurnRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated state and skill reply.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TurnResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/v1/newproject/{id}/ratify": {
      "post": {
        "tags": ["newproject"],
        "summary": "Nonce-confirmed atomic commit. Executes the 10-step ratification transaction and creates the project on disk.",
        "operationId": "ratifyNewProject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Session id returned by `startNewProject`.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RatifyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project committed successfully.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RatifyResponse" }
              }
            }
          },
          "400": {
            "description": "Validation failure (e.g. empty ProjectName). `error` = `validation_failed`.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RatifyError" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Conflict — either the session state has changed since the modal opened (`error` = `stale_state`) or the target directory already exists (`error` = `dir_exists`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RatifyError" }
              }
            }
          },
          "422": {
            "description": "Dependency cycle detected in the plan tree (`error` = `cycle_detected`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RatifyError" }
              }
            }
          },
          "500": {
            "description": "Transaction step failed (git_init_failed, beads_init_failed, milestone_create_failed, epic_create_failed, bead_create_failed, dep_resolve_failed, stat_failed, mkdir_failed, project_md_failed, commit_failed).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RatifyError" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/v1/newproject/create": {
      "post": {
        "tags": ["newproject"],
        "summary": "Lightweight project creation. Scaffolds a project (dir + git init + .gemba/workspace.toml + beads DB + initial commit) without spawning the Onboarder or calling an LLM. Same atomic ratify transaction as the conversational flow, but with an empty Milestones[] tree.",
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProjectRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project scaffolded successfully. `milestone_count` and `epic_count` are both 0 on this path.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RatifyResponse" }
              }
            }
          },
          "400": {
            "description": "Validation failure — missing or empty `project_name`.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "Target directory already exists (`error` = `dir_exists`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RatifyError" }
              }
            }
          },
          "500": {
            "description": "Transaction step failed (git_init_failed, beads_init_failed, mkdir_failed, project_md_failed, commit_failed).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RatifyError" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/AdaptorUnavailable" }
        }
      }
    },
    "/api/v1/onboarder/probe": {
      "get": {
        "tags": ["newproject"],
        "summary": "Reports whether the Onboarder persona host can resolve an LLM client. The SPA reads this on board empty-state to decide whether to render the optional 'Plan with the Onboarder' CTA.",
        "operationId": "probeOnboarder",
        "responses": {
          "200": {
            "description": "Probe result. Always 200 — `available` is the operative signal; when false, `reason` carries the operator-facing diagnostic.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OnboarderProbeResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Malformed request — invalid query parameters or body.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "AdaptorUnavailable": {
        "description": "Adaptor is not registered or is degraded; the SPA shows a banner and keeps cached data visible.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Shared error envelope (gm-faz). `error` is a stable token the SPA branches on; `message` is human-readable and may be surfaced verbatim.",
        "required": ["error", "message"],
        "properties": {
          "error": { "type": "string", "examples": ["adaptor_degraded", "validation", "not_found"] },
          "message": { "type": "string" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "examples": ["ok"] }
        }
      },
      "VersionResponse": {
        "type": "object",
        "required": ["component", "status"],
        "properties": {
          "component": { "type": "string", "examples": ["gemba"] },
          "status": { "type": "string", "examples": ["pre-alpha scaffold"] }
        }
      },
      "BeadsSource": {
        "type": "object",
        "description": "Workspace identity — 1:1 with a beads database (gm-77u). Detail strips credentials when source is a dolt-url.",
        "required": ["kind", "label"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["beads-dir", "dolt-url", "unconfigured"]
          },
          "label": { "type": "string" },
          "detail": { "type": "string" }
        }
      },
      "ConfigResponse": {
        "type": "object",
        "required": ["auth_mode", "yolo_available", "listen", "port", "city", "town", "beads_source"],
        "properties": {
          "auth_mode": { "type": "string", "enum": ["none", "token", "oidc"] },
          "yolo_available": { "type": "boolean" },
          "listen": { "type": "string" },
          "port": { "type": "integer" },
          "city": { "type": "string" },
          "town": { "type": "string" },
          "beads_source": { "$ref": "#/components/schemas/BeadsSource" }
        }
      },
      "Repository": {
        "type": "object",
        "required": ["id", "path", "default_branch", "bead_prefix"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "default_branch": { "type": "string" },
          "url": { "type": "string" },
          "worktrees_dir": { "type": "string" },
          "bead_prefix": { "type": "string" }
        }
      },
      "ListRepositoriesEnvelope": {
        "type": "object",
        "required": ["repositories"],
        "properties": {
          "repositories": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Repository" }
          },
          "notice": { "type": "string" }
        }
      },
      "StateCategory": {
        "type": "string",
        "enum": ["backlog", "unstarted", "staged", "started", "completed", "canceled"]
      },
      "AgentRef": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      },
      "WorkItem": {
        "type": "object",
        "description": "Subset of the WorkItem fields most commonly read by the SPA. The full shape (relationships, evidence, dod, derived signals, custom fields) is the source of truth in `core/types.go` and `web/src/types/core.gen.ts`; this schema documents the wire-stable subset for a typed client. `additionalProperties: true` keeps clients forward-compatible with fields landing in follow-up beads.",
        "additionalProperties": true,
        "required": ["id", "kind", "title", "status", "state_category", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "examples": ["epic", "task", "feature", "decision"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string" },
          "state_category": { "$ref": "#/components/schemas/StateCategory" },
          "priority": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
          "owner": { "$ref": "#/components/schemas/AgentRef" },
          "assignee": { "$ref": "#/components/schemas/AgentRef" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "primary_repository_id": { "type": "string" },
          "repository_ids": { "type": "array", "items": { "type": "string" } },
          "sprint_id": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ListWorkItemsEnvelope": {
        "type": "object",
        "required": ["items", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WorkItem" }
          },
          "total": { "type": "integer" }
        }
      },
      "Sprint": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "starts_at": { "type": "string", "format": "date-time" },
          "ends_at": { "type": "string", "format": "date-time" }
        }
      },
      "ListSprintsEnvelope": {
        "type": "object",
        "required": ["sprints"],
        "properties": {
          "sprints": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Sprint" }
          }
        }
      },
      "Agent": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "label": { "type": "string" }
        }
      },
      "ListAgentsEnvelope": {
        "type": "object",
        "required": ["agents"],
        "properties": {
          "agents": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Agent" }
          }
        }
      },
      "AgentGroup": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ListAgentGroupsEnvelope": {
        "type": "object",
        "required": ["agent_groups"],
        "properties": {
          "agent_groups": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AgentGroup" }
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "agent_id": { "type": "string" },
          "status": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" }
        }
      },
      "SessionListEnvelope": {
        "type": "object",
        "required": ["sessions"],
        "properties": {
          "sessions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Session" }
          }
        }
      },
      "Escalation": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "EscalationListEnvelope": {
        "type": "object",
        "required": ["escalations"],
        "properties": {
          "escalations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Escalation" }
          }
        }
      },
      "Transport": {
        "type": "string",
        "enum": ["api", "jsonl", "mcp", "exec", "ipc"]
      },
      "CapabilityManifest": {
        "type": "object",
        "description": "Subset of the manifest fields the SPA actively gates UI on. Full manifest (state_map, edge_extensions, query_languages, etc.) is documented in `core/manifest.go`; this schema captures the wire-stable boolean / version surface.",
        "additionalProperties": true,
        "required": ["adaptor_name", "adaptor_version", "protocol_version", "transport"],
        "properties": {
          "adaptor_name": { "type": "string" },
          "adaptor_version": { "type": "string" },
          "protocol_version": { "type": "string" },
          "transport": { "$ref": "#/components/schemas/Transport" },
          "sprint_native": { "type": "boolean" },
          "token_budget_enforced": { "type": "boolean" },
          "evidence_synthesis_required": { "type": "boolean" },
          "read_only": { "type": "boolean" },
          "dependency_graph_native": { "type": "boolean" },
          "ready_set_query": { "type": "boolean" }
        }
      },
      "CapabilitiesResponse": {
        "type": "object",
        "description": "One entry per registered transport plane (`workplane`, `orchestration`).",
        "properties": {
          "workplane": { "$ref": "#/components/schemas/CapabilityManifest" },
          "orchestration": { "$ref": "#/components/schemas/CapabilityManifest" }
        }
      },
      "AdaptorStatus": {
        "type": "object",
        "required": ["adaptor_id", "plane", "ok"],
        "properties": {
          "adaptor_id": { "type": "string" },
          "plane": { "type": "string", "enum": ["work", "orchestration"] },
          "ok": { "type": "boolean" },
          "message": { "type": "string" },
          "checked_at": { "type": "string", "format": "date-time" }
        }
      },
      "AdaptorsHealthResponse": {
        "type": "object",
        "required": ["adaptors"],
        "properties": {
          "adaptors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AdaptorStatus" }
          }
        }
      },
      "ChangeRef": {
        "type": "object",
        "description": "Points into the plan tree for the most-recent skill edit. The SPA tone-codes the diff badge by `kind`. Path is slash-joined (e.g. `milestone:1/epic:0/bead:2`); empty means the change spans the whole tree.",
        "required": ["path", "kind", "summary"],
        "properties": {
          "path": { "type": "string", "examples": ["milestone:1/epic:0/bead:2"] },
          "kind": {
            "type": "string",
            "enum": ["added", "removed", "renamed", "edited", ""],
            "description": "Labels what changed. Empty string means the skill did not categorise the change."
          },
          "summary": { "type": "string", "description": "Human-readable one-liner. Empty when the skill did not synthesise one." }
        }
      },
      "DraftBead": {
        "type": "object",
        "description": "Leaf of the plan tree. All fields are required; empty strings and zero integers are valid empty states (no missing-key surprises at ratification).",
        "required": ["Title", "Description", "Type", "Acceptance", "Labels", "Priority", "Estimate", "Skills", "DesignNotes", "Notes", "DependsOnRefs", "BlocksRefs"],
        "properties": {
          "Title": { "type": "string" },
          "Description": { "type": "string" },
          "Type": {
            "type": "string",
            "description": "One of `task` | `bug` | `feature` | `chore` today. Open string so future bead kinds do not break the SPA.",
            "examples": ["task", "bug", "feature", "chore"]
          },
          "Acceptance": { "type": "string" },
          "Labels": { "type": "array", "items": { "type": "string" } },
          "Priority": { "type": "integer", "minimum": 0 },
          "Estimate": { "type": "integer", "minimum": 0 },
          "Skills": { "type": "array", "items": { "type": "string" } },
          "DesignNotes": { "type": "string" },
          "Notes": { "type": "string" },
          "DependsOnRefs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Intra-tree refs (e.g. `milestone:0/epic:1/bead:2`). Ratification resolves these to real bd-… ids in step 8a."
          },
          "BlocksRefs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Intra-tree refs for beads this bead blocks."
          }
        }
      },
      "DraftEpic": {
        "type": "object",
        "description": "Groups beads under a milestone in the plan tree.",
        "required": ["Title", "Description", "Acceptance", "Labels", "Priority", "Estimate", "Skills", "DesignNotes", "Notes", "Beads"],
        "properties": {
          "Title": { "type": "string" },
          "Description": { "type": "string" },
          "Acceptance": { "type": "string" },
          "Labels": { "type": "array", "items": { "type": "string" } },
          "Priority": { "type": "integer", "minimum": 0 },
          "Estimate": { "type": "integer", "minimum": 0 },
          "Skills": { "type": "array", "items": { "type": "string" } },
          "DesignNotes": { "type": "string" },
          "Notes": { "type": "string" },
          "Beads": { "type": "array", "items": { "$ref": "#/components/schemas/DraftBead" } }
        }
      },
      "DraftMilestone": {
        "type": "object",
        "description": "Top-level node of the plan tree. The `type:milestone` label is added by ratification, not by the skill.",
        "required": ["Title", "Description", "Acceptance", "Labels", "Priority", "Estimate", "Skills", "DesignNotes", "Notes", "Epics"],
        "properties": {
          "Title": { "type": "string" },
          "Description": { "type": "string" },
          "Acceptance": { "type": "string" },
          "Labels": { "type": "array", "items": { "type": "string" } },
          "Priority": { "type": "integer", "minimum": 0 },
          "Estimate": { "type": "integer", "minimum": 0 },
          "Skills": { "type": "array", "items": { "type": "string" } },
          "DesignNotes": { "type": "string" },
          "Notes": { "type": "string" },
          "Epics": { "type": "array", "items": { "$ref": "#/components/schemas/DraftEpic" } }
        }
      },
      "NewProjectState": {
        "type": "object",
        "description": "Authoritative server-side state for one new-project session. Each turn returns a fresh copy; the client replaces its local copy wholesale rather than merging diffs.",
        "required": ["ProjectName", "Description", "TechStack", "Architecture", "Milestones", "DraftProjectMD", "Turn", "LastChange"],
        "properties": {
          "ProjectName": { "type": "string" },
          "Description": { "type": "string" },
          "TechStack": { "type": "array", "items": { "type": "string" } },
          "Architecture": { "type": "string", "description": "Free-form architecture notes captured from the operator." },
          "Milestones": { "type": "array", "items": { "$ref": "#/components/schemas/DraftMilestone" } },
          "DraftProjectMD": {
            "type": "string",
            "description": "Running narrative the skill keeps current each turn. Ratification persists this verbatim as `docs/project.md`."
          },
          "Turn": {
            "type": "integer",
            "minimum": 0,
            "description": "Monotonic turn counter. Starts at 0; incremented on every successful turn. The ratify endpoint uses this as a stale-modal guard."
          },
          "LastChange": { "$ref": "#/components/schemas/ChangeRef" }
        }
      },
      "StartNewProjectResponse": {
        "type": "object",
        "description": "Returned by `POST /api/v1/newproject/start`.",
        "required": ["session_id", "state", "greeting"],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque session id used to scope subsequent /turn and /ratify calls. Lives only in server memory.",
            "examples": ["newproj-a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6"]
          },
          "state": { "$ref": "#/components/schemas/NewProjectState" },
          "greeting": {
            "type": "string",
            "description": "Optional opening line from the Onboarder. Empty string when the skill did not emit one."
          }
        }
      },
      "TurnRequest": {
        "type": "object",
        "description": "Request body for `POST /api/v1/newproject/:id/turn`.",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "description": "Operator message. Free text — the skill parses intent." },
          "edits": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional in-place edits the operator made to the plan preview pane since the last turn. Open shape — the skill interprets the path-keyed diff."
          }
        }
      },
      "TurnResponse": {
        "type": "object",
        "description": "Returned by `POST /api/v1/newproject/:id/turn`.",
        "required": ["state", "reply", "reply_id", "reply_at"],
        "properties": {
          "state": { "$ref": "#/components/schemas/NewProjectState" },
          "reply": {
            "type": "string",
            "description": "Skill reply for the conversation pane. Empty when the skill updates the plan silently."
          },
          "reply_id": {
            "type": "string",
            "description": "Server-assigned message id for the reply (stable across re-renders)."
          },
          "reply_at": {
            "type": "string",
            "format": "date-time",
            "description": "Server-supplied timestamp for the reply (RFC3339Nano)."
          }
        }
      },
      "RatifyRequest": {
        "type": "object",
        "description": "Request body for `POST /api/v1/newproject/:id/ratify`. The server compares the submitted `state.Turn` against the live session and rejects mismatches (stale-modal guard).",
        "required": ["state"],
        "properties": {
          "state": { "$ref": "#/components/schemas/NewProjectState" }
        }
      },
      "RatifyResponse": {
        "type": "object",
        "description": "Success envelope returned by `POST /api/v1/newproject/:id/ratify` after the 10-step transaction completes. The SPA owns post-ratify navigation (gm-root.17.7); the server returns the new project's filesystem root, its display name, and the seeded milestone / epic counts so the handoff screen can render 'seeded N milestones and M epics' without re-querying the new workspace's beads database.",
        "required": ["project_path", "project_name", "milestone_count", "epic_count"],
        "properties": {
          "project_path": {
            "type": "string",
            "description": "Filesystem path of the new project root (default_dir/<project-name>/)."
          },
          "project_name": {
            "type": "string",
            "description": "Human-readable project name echoed from the ratified state."
          },
          "milestone_count": {
            "type": "integer",
            "description": "Number of milestones created by the transaction.",
            "minimum": 0
          },
          "epic_count": {
            "type": "integer",
            "description": "Number of epics created by the transaction (sum across all milestones).",
            "minimum": 0
          }
        }
      },
      "RatifyError": {
        "type": "object",
        "description": "Structured error returned by `POST /api/v1/newproject/:id/ratify` when any transaction step fails. `error` is a stable machine-readable code; `step` is the 1-based transaction step that failed.",
        "required": ["error", "message", "step"],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "validation_failed",
              "dir_exists",
              "mkdir_failed",
              "stat_failed",
              "git_init_failed",
              "beads_init_failed",
              "milestone_create_failed",
              "epic_create_failed",
              "bead_create_failed",
              "dep_resolve_failed",
              "cycle_detected",
              "project_md_failed",
              "commit_failed",
              "stale_state"
            ],
            "description": "Stable machine-readable error token."
          },
          "message": { "type": "string", "description": "Human-readable diagnostic surfaced in the toast." },
          "step": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based transaction step that failed (1..10; step 8a dep-resolution is encoded as 8)."
          }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "description": "Body for `POST /api/v1/newproject/create` — the lightweight project-creation path. No session, no Onboarder, no LLM. The server runs the same atomic ratify transaction the conversational flow uses, but with an empty Milestones[] tree (gm-root.17.13).",
        "required": ["project_name"],
        "properties": {
          "project_name": {
            "type": "string",
            "minLength": 1,
            "description": "Project name. Used as the directory name under default_dir."
          },
          "description": {
            "type": "string",
            "description": "Optional one-or-two-line description. Mirrored into .gemba/workspace.toml and the synthesised docs/project.md."
          }
        }
      },
      "OnboarderProbeResponse": {
        "type": "object",
        "description": "Body for `GET /api/v1/onboarder/probe`. Always 200; `available` is the operative signal. When `available` is false, `reason` carries the operator-facing diagnostic the SPA can surface verbatim.",
        "required": ["available"],
        "properties": {
          "available": {
            "type": "boolean",
            "description": "True when the Onboarder persona host can resolve an LLM client (i.e. the conversational flow at /onboard would not 503)."
          },
          "reason": {
            "type": "string",
            "description": "Operator-facing diagnostic explaining why the Onboarder is unavailable. Empty / omitted when available is true."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token auth (gm-e5.1). Required when the server boots with `--auth=token`."
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gemba_session",
        "description": "Signed session cookie issued by `POST /api/auth/login` after a bearer exchange."
      }
    }
  },
  "security": [
    { "bearerToken": [] },
    { "sessionCookie": [] },
    {}
  ]
}
