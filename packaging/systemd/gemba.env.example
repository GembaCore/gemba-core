# /etc/gemba/gemba.env — operator-tunable env for the gemba.service unit.
# Copy to /etc/gemba/gemba.env and chmod 0640 root:gemba. Lines beginning
# with '#' are ignored; key=value, no quoting required by systemd.

# --- Listen / TLS ------------------------------------------------------
# The default ExecStart in gemba.service binds to 127.0.0.1:7666 with no
# auth — fine for a reverse-proxied deployment. To expose directly, edit
# the unit's ExecStart and turn auth on at the same time.
#
# GEMBA_LOG_LEVEL=info

# --- Auth --------------------------------------------------------------
# When ExecStart includes --auth token, gemba reads the token hash from
# the standard config dir (XDG_CONFIG_HOME/gemba or ~/.config/gemba).
# Rotate it via:
#   sudo -u gemba /usr/local/bin/gemba auth token rotate
# The rotate command prints the new bearer once on stdout.

# --- WorkPlane ---------------------------------------------------------
# Point gemba at the project worktree or Dolt URL. Pick one mode.
# GEMBA_PROJECT_DIR=/var/lib/gemba/project
# GEMBA_DOLT_URL=mysql://gemba:secret@127.0.0.1:3307/myrig

# --- Orchestration -----------------------------------------------------
# Native + tmux is the MVP default; container backend needs DOCKER_HOST.
# DOCKER_HOST=ssh://op@vps.example.com
