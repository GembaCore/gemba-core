{
  "name": "gemba-acceptance-temperature-spa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Headless acceptance test for native + gastown end-to-end SPA build via beads (gm-root.27).",
  "scripts": {
    "test:unit": "node --test --experimental-strip-types --test-timeout=15000 shared/helpers/*.test.ts",
    "test:e2e": "playwright test",
    "test:native": "playwright test --project=acceptance-native",
    "test:gastown": "GEMBA_ACCEPTANCE_RUN_GASTOWN=1 playwright test --project=acceptance-gastown",
    "test:demo": "GEMBA_ACCEPTANCE_DEMO_MODE=1 playwright test --project=acceptance-native-demo",
    "test:demo:real": "GEMBA_ACCEPTANCE_DEMO_MODE=1 GEMBA_ACCEPTANCE_REAL_AGENTS=1 playwright test --project=acceptance-native-demo",
    "test:demo:claude": "GEMBA_ACCEPTANCE_DEMO_MODE=1 GEMBA_ACCEPTANCE_REAL_AGENTS=1 GEMBA_ACCEPTANCE_AGENT=claude playwright test --project=acceptance-native-demo",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
