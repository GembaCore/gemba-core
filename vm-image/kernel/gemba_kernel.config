# Gemba microVM kernel config (Linux 6.1).
#
# Derived from Firecracker's upstream "microvm" recommended config
# (https://github.com/firecracker-microvm/firecracker/blob/main/resources/guest_configs/microvm-kernel-ci-x86_64-5.10.config)
# upgraded to 6.1 and tuned for Gemba's needs: virtio-fs for the
# /workspace pass-through, seccomp for agent sandboxing, no graphical
# or audio drivers.
#
# Run `make olddefconfig` against an unpacked 6.1 source tree to
# materialize the full .config from this fragment.

# --- Platform ---
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# --- Boot path ---
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_BLK_DEV_INITRD=n
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 reboot=k panic=1 pci=off nomodules"

# --- Drivers we keep ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Security ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Drivers we explicitly drop ---
# No framebuffer, no DRM, no sound, no USB, no SATA, no input.
# CONFIG_FB is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_ATA is not set
# CONFIG_INPUT is not set
# CONFIG_MODULES is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
